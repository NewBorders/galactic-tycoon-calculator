<script setup lang="ts">
import { ref } from 'vue'
import type { GameData, GdIndex } from '@/v2/services/gamedata/types'
import type { PlayerBase } from '@/v2/services/playerBases'
import { useGlobalSummary } from '@/v2/composables/useGlobalSummary'
import { formatPrice, formatNumber } from '@/v2/utils/formatNumber'
import { translate } from '@/v2/localisation'
import MaterialIcon from '@/v2/components/MaterialIcon.vue'

const props = defineProps<{
  bases: PlayerBase[]
  gameData: GameData
  index: GdIndex
  priceResolver: (materialId: number) => number
  technologyLevels: Partial<Record<number, number>>
  startingBonus: number
  timeframeHours: number
  globalWorkforceBurden: number
}>()

const isOpen = ref(true)
const expandedBases = ref<Set<string>>(new Set())
const expandedMaterials = ref(false)

const { baseSummaries, totalNetProfit, totalWorkforceDeficitCost, totalConsumptionOverheadCost, globalMaterials } =
  useGlobalSummary(
    props.bases,
    props.gameData,
    props.index,
    props.priceResolver,
    props.technologyLevels,
    props.startingBonus,
    props.timeframeHours,
    props.globalWorkforceBurden,
  )

function toggleBase(baseId: string) {
  if (expandedBases.value.has(baseId)) {
    expandedBases.value.delete(baseId)
  } else {
    expandedBases.value.add(baseId)
  }
}

function getMaterialName(materialId: number): string {
  const material = props.gameData.materials.find((m) => m.id === materialId)
  return material?.name ?? `Material ${materialId}`
}

function getPlanetName(planetId: number): string {
  const planet = props.gameData.planets.find((p) => p.id === planetId)
  return planet?.name ?? `Planet ${planetId}`
}

function formatDays(days: number): string {
  if (days < 1) {
    const hours = Math.floor(days * 24)
    return `${hours}h`
  }
  return `${Math.floor(days)}d`
}
</script>

<template>
  <details class="border border-amber-600 rounded bg-gradient-to-br from-slate-800 to-slate-900 mb-4" :open="isOpen" @toggle="isOpen = ($event.target as HTMLDetailsElement).open">
    <summary class="px-4 py-3 cursor-pointer font-semibold text-amber-300 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
      <span>{{ translate('globalSummary') }}</span>
    </summary>

    <div class="px-4 py-3 space-y-4">
      <!-- Key Metrics -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-slate-700/50 rounded p-3">
          <div class="text-sm text-slate-400">{{ translate('totalNetProfit') }}</div>
          <div class="text-2xl font-bold" :class="totalNetProfit >= 0 ? 'text-emerald-300' : 'text-rose-300'">
            {{ formatPrice(totalNetProfit, 2) }}
          </div>
        </div>

        <div class="bg-slate-700/50 rounded p-3">
          <div class="text-sm text-slate-400">{{ translate('workforceDeficitCost') }}</div>
          <div class="text-2xl font-bold text-rose-300">
            {{ formatPrice(totalWorkforceDeficitCost, 2) }}
          </div>
          <div class="text-xs text-slate-500 mt-1">{{ translate('workforceDeficitHint') }}</div>
        </div>

        <div class="bg-slate-700/50 rounded p-3">
          <div class="text-sm text-slate-400">{{ translate('consumptionOverheadCost') }}</div>
          <div class="text-2xl font-bold text-amber-300">
            {{ formatPrice(totalConsumptionOverheadCost, 2) }}
          </div>
          <div class="text-xs text-slate-500 mt-1">{{ translate('consumptionOverheadHint') }}</div>
        </div>
      </div>

      <!-- Per-Base Summary -->
      <div class="space-y-2">
        <h3 class="text-lg font-semibold text-slate-300">{{ translate('perBaseSummary') }}</h3>
        <div class="space-y-2">
          <div
            v-for="baseSummary in baseSummaries"
            :key="baseSummary.baseId"
            class="border border-slate-600 rounded bg-slate-800/50"
          >
            <div
              class="px-3 py-2 cursor-pointer flex items-center justify-between hover:bg-slate-700/30"
              @click="toggleBase(baseSummary.baseId)"
            >
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 transition-transform flex-shrink-0"
                  :class="{ 'rotate-90': expandedBases.has(baseSummary.baseId) }"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span class="font-medium truncate">{{ baseSummary.baseName }}</span>
                <span class="text-sm text-slate-500 truncate">{{ getPlanetName(baseSummary.planetId) }}</span>
              </div>
              <div class="flex items-center gap-4 flex-shrink-0">
                <div class="text-right">
                  <div class="text-sm text-slate-400">{{ translate('netResult') }}</div>
                  <div class="font-bold" :class="baseSummary.netProfit >= 0 ? 'text-emerald-300' : 'text-rose-300'">
                    {{ formatPrice(baseSummary.netProfit, 2) }}
                  </div>
                </div>
                <div v-if="baseSummary.workforceDeficit > 0" class="text-right">
                  <div class="text-sm text-slate-400">{{ translate('housingShortfall') }}</div>
                  <div class="font-bold text-orange-300">
                    {{ formatNumber(baseSummary.workforceDeficit, 0) }}
                  </div>
                </div>
                <div v-if="baseSummary.materialsRunningOut.length > 0" class="text-right">
                  <div class="text-sm text-rose-400">⚠ {{ baseSummary.materialsRunningOut.length }} {{ translate('materialsRunningOut') }}</div>
                </div>
              </div>
            </div>

            <!-- Expanded Base Details -->
            <div v-if="expandedBases.has(baseSummary.baseId)" class="px-3 py-2 border-t border-slate-600 space-y-3">
              <!-- Revenue Breakdown -->
              <div class="grid grid-cols-3 gap-2 text-sm">
                <div>
                  <span class="text-slate-400">{{ translate('productionRevenue') }}:</span>
                  <span class="text-emerald-300 ml-1">{{ formatPrice(baseSummary.productionRevenue, 2) }}</span>
                </div>
                <div>
                  <span class="text-slate-400">{{ translate('materialPurchaseCosts') }}:</span>
                  <span class="text-rose-300 ml-1">{{ formatPrice(baseSummary.materialPurchaseCosts, 2) }}</span>
                </div>
                <div>
                  <span class="text-slate-400">{{ translate('workerPurchaseCosts') }}:</span>
                  <span class="text-rose-300 ml-1">{{ formatPrice(baseSummary.workerPurchaseCosts, 2) }}</span>
                </div>
              </div>

              <!-- Materials Running Out -->
              <div v-if="baseSummary.materialsRunningOut.length > 0">
                <div class="text-sm font-semibold text-rose-300 mb-1">{{ translate('materialsRunningOut') }}:</div>
                <div class="space-y-1">
                  <div
                    v-for="material in baseSummary.materialsRunningOut.slice(0, 5)"
                    :key="material.materialId"
                    class="flex items-center gap-2 text-sm"
                  >
                    <MaterialIcon :name="getMaterialName(material.materialId)" :size="16" />
                    <span class="text-slate-300">{{ getMaterialName(material.materialId) }}</span>
                    <span class="text-rose-400 font-medium ml-auto">
                      {{ formatDays(material.daysUntilEmpty) }}
                    </span>
                    <span class="text-slate-500 text-xs">
                      ({{ formatNumber(material.currentStock, 0) }} / -{{ formatNumber(material.consumptionPerDay, 1) }}/d)
                    </span>
                  </div>
                  <div v-if="baseSummary.materialsRunningOut.length > 5" class="text-xs text-slate-500 pl-6">
                    +{{ baseSummary.materialsRunningOut.length - 5 }} {{ translate('more') }}
                  </div>
                </div>
              </div>

              <!-- Materials for Selling -->
              <div v-if="baseSummary.materialsForSelling.length > 0">
                <div class="text-sm font-semibold text-emerald-300 mb-1">{{ translate('materialsForSelling') }}:</div>
                <div class="space-y-1">
                  <div
                    v-for="material in baseSummary.materialsForSelling.slice(0, 5)"
                    :key="material.materialId"
                    class="flex items-center gap-2 text-sm"
                  >
                    <MaterialIcon :name="getMaterialName(material.materialId)" :size="16" />
                    <span class="text-slate-300">{{ getMaterialName(material.materialId) }}</span>
                    <span class="text-emerald-400 font-medium ml-auto">
                      +{{ formatNumber(material.productionPerDay, 1) }}/d
                    </span>
                    <span class="text-slate-400 text-xs">
                      ({{ formatPrice(material.valuePerDay, 2) }}/d)
                    </span>
                  </div>
                  <div v-if="baseSummary.materialsForSelling.length > 5" class="text-xs text-slate-500 pl-6">
                    +{{ baseSummary.materialsForSelling.length - 5 }} {{ translate('more') }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Global Material Production/Consumption -->
      <div class="space-y-2">
        <div
          class="flex items-center justify-between cursor-pointer hover:bg-slate-700/30 rounded px-2 py-1"
          @click="expandedMaterials = !expandedMaterials"
        >
          <h3 class="text-lg font-semibold text-slate-300 flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 transition-transform"
              :class="{ 'rotate-90': expandedMaterials }"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            {{ translate('globalMaterialSummary') }}
          </h3>
          <span class="text-sm text-slate-500">{{ globalMaterials.length }} {{ translate('materials') }}</span>
        </div>

        <div v-if="expandedMaterials" class="space-y-1">
          <div
            v-for="material in globalMaterials.slice(0, 20)"
            :key="material.materialId"
            class="bg-slate-800/50 rounded px-3 py-2"
          >
            <div class="flex items-center gap-2 mb-1">
              <MaterialIcon :name="getMaterialName(material.materialId)" :size="20" />
              <span class="text-slate-300 font-medium">{{ getMaterialName(material.materialId) }}</span>
              <span class="ml-auto font-bold" :class="material.netBalance >= 0 ? 'text-emerald-300' : 'text-rose-300'">
                {{ material.netBalance >= 0 ? '+' : '' }}{{ formatNumber(material.netBalance, 1) }}/d
              </span>
            </div>
            <div class="text-xs text-slate-500 grid grid-cols-2 gap-1 pl-7">
              <div>{{ translate('production') }}: +{{ formatNumber(material.totalProduction, 1) }}/d</div>
              <div>{{ translate('consumption') }}: -{{ formatNumber(material.totalConsumption, 1) }}/d</div>
            </div>
            <!-- Per-base breakdown -->
            <div class="text-xs text-slate-600 pl-7 mt-1 space-y-0.5">
              <div v-for="base in material.perBaseBreakdown" :key="base.baseId" class="flex items-center gap-2">
                <span class="truncate w-32">{{ base.baseName }}</span>
                <span v-if="base.production > 0" class="text-emerald-400">+{{ formatNumber(base.production, 1) }}</span>
                <span v-if="base.consumption > 0" class="text-rose-400">-{{ formatNumber(base.consumption, 1) }}</span>
              </div>
            </div>
          </div>
          <div v-if="globalMaterials.length > 20" class="text-sm text-slate-500 text-center py-2">
            +{{ globalMaterials.length - 20 }} {{ translate('more') }}
          </div>
        </div>
      </div>
    </div>
  </details>
</template>
